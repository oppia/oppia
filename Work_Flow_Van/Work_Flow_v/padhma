}> = [];

// Sorting/filtering/paging
sortKey: 'plays' | 'average_rating' | 'num_open_threads' = 'plays';
sortDir: 'asc' | 'desc' = 'desc';
filterText = '';
filterKey: 'all' | 'high_rating' | 'low_rating' | 'has_open_threads' | 'recently_updated' | 'high_plays' = 'all';
pageIndex = 0;
pageSize = 10;

// Charts and sections (added)
