{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "oppia-angular": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss"
        }
      },
      "root": "",
      "sourceRoot": "",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:browser",
          "options": {
            "allowedCommonJsDependencies": ["path", "stream", "zlib"],
            "outputPath": "dist/oppia-angular",
            "deployUrl": "/dist/oppia-angular/",
            "index": {
              "input": "src/index.html",
              "output": "oppia-root.mainpage.html"
            },
            "main": "src/main.ts",
            "polyfills": "core/templates/Polyfills.ts",
            "tsConfig": "tsconfig.json",
            "assets": [
              "src/favicon.ico",
              {
                "glob": "**/*",
                "input": "assets/",
                "output": "/assets/"
              },
              {
                "glob": "**/*",
                "input": "extensions/",
                "output": "/extensions/"
              },
              {
                "glob": "**/*",
                "input": "third_party/static/",
                "output": "/third_party/static/",
                "ignore": [
                "**/*.py",
                "**/*.pyc",
                "**/__pycache__/**"
                ]
              },
              {
                "glob": "**/*",
                "input": "node_modules/mathjax",
                "output": "/assets/mathjax"
              },
              {
                "glob": "**/*",
                "input": "./node_modules/midi/examples/soundfont/",
                "output": "./midi/examples/soundfont/"
              },
              {
                "glob": "**/*",
                "input": "node_modules/@fortawesome/fontawesome-free/webfonts",
                "output": "assets/webfonts"
              },
              {
                "glob": "**/*",
                "input": "node_modules/ckeditor4",
                "output": "/third_party/ckeditor"
              },
              {
                "glob": "**/*",
                "input": "node_modules/ckeditor4-bootstrapck",
                "output": "/third_party/ckeditor-bootstrapck"
              }
            ],
            "styles": [
              {
                "input": "src/vendor-styles.css",
                "bundleName": "vendor-styles",
                "inject": true
              },
              {
                "input": "node_modules/charts.css/dist/charts.css",
                "bundleName": "charts-library",
                "inject": true
              },
              "core/templates/css/oppia.css",
              "core/templates/css/oppia-material.css",
              "node_modules/ngx-toastr/toastr.css",
              "node_modules/shepherd.js/dist/css/shepherd.css",
              "core/templates/css/shepherd-overrides.css",
              "node_modules/guppy-dev/build/guppy-default.min.css",
              "node_modules/cropperjs/dist/cropper.min.css",
              "node_modules/codemirror/lib/codemirror.css",
              "node_modules/codemirror/addon/merge/merge.css"
            ],
            "scripts": [
              "node_modules/bootstrap/dist/js/bootstrap.bundle.js"
            ]
          },
          "configurations": {
            "production": {
              "fileReplacements": [
                {
                  "replace": "src/environments/environment.ts",
                  "with": "src/environments/environment.prod.ts"
                }
              ],
              "index": {
                "input": "src/index.prod.html",
                "output": "oppia-root.mainpage.html"
              },
              "deployUrl": "/build/",
              "outputPath": "build",
              "aot": true,
              "optimization": true,
              "outputHashing": "all",
              "sourceMap": false,
              "namedChunks": false,
              "extractLicenses": true,
              "vendorChunk": false,
              "buildOptimizer": true,
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kb",
                  "maximumError": "2mb"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "6kb",
                  "maximumError": "29kb"
                }
              ]
            }
          }
        },
        "serve": {
          "builder": "@angular-devkit/build-angular:dev-server",
          "options": {
            "browserTarget": "oppia-angular:build"
          },
          "configurations": {
            "production": {
              "browserTarget": "oppia-angular:build:production"
            }
          }
        },
        "extract-i18n": {
          "builder": "@angular-devkit/build-angular:extract-i18n",
          "options": {
            "browserTarget": "oppia-angular:build"
          }
        },
        "test": {
          "builder": "@angular-devkit/build-angular:karma",
          "options": {
            "main": "core/templates/combined-tests.spec.ts",
            "polyfills": "core/templates/Polyfills.ts",
            "tsConfig": "tsconfig.spec.json",
            "karmaConfig": "core/tests/karma.conf.ts",
            "codeCoverageExclude": [
              "core/templates/expressions/parser.js",
              "core/templates/Polyfills.ts"
            ],
            "assets": [
              "src/favicon.ico",
              {
                "glob": "**/*",
                "input": "assets/",
                "output": "/assets/"
              },
              {
                "glob": "**/*",
                "input": "extensions/",
                "output": "/extensions/"
              },
              {
                "glob": "**/*",
                "input": "node_modules/mathjax",
                "output": "/assets/mathjax"
              },
              {
                "glob": "**/*",
                "input": "node_modules/@fortawesome/fontawesome-free/webfonts",
                "output": "assets/webfonts"
              }
            ],
            "styles": [
              {
                "input": "src/vendor-styles.css",
                "bundleName": "vendor-styles",
                "inject": true
              },
              {
                "input": "node_modules/charts.css/dist/charts.css",
                "bundleName": "charts-library",
                "inject": true
              },
              "core/templates/css/oppia.css",
              "core/templates/css/oppia-material.css",
              "node_modules/ngx-toastr/toastr.css",
              "node_modules/shepherd.js/dist/css/shepherd.css",
              "core/templates/css/shepherd-overrides.css",
              "node_modules/guppy-dev/build/guppy-default.min.css",
              "node_modules/cropperjs/dist/cropper.min.css",
              "node_modules/codemirror/lib/codemirror.css",
              "node_modules/codemirror/addon/merge/merge.css"
            ],
            "scripts": [
              "node_modules/bootstrap/dist/js/bootstrap.bundle.js"
            ]
          },
          "configurations": {
            "production": {
              "fileReplacements": [
                {
                  "replace": "src/environments/environment.ts",
                  "with": "src/environments/environment.prod.ts"
                }
              ]
            }
          }
        },
        "lint": {
          "builder": "@angular-eslint/builder:lint",
          "options": {
            "lintFilePatterns": [
              "core/templates/**/*.ts",
              "core/templates/**/*.component.html",
              "core/templates/**/*.directive.html",
              "extensions/**/*.ts",
              "extensions/**/*.html"
            ]
          }
        }
      }
    }
  },
  "defaultProject": "oppia-angular"
}
